LOG_LEVEL=info
DATABASE_URL=postgres://app:app@postgres:5432/streamclone?sslmode=disable
REDIS_URL=redis://redis:6379/0
SCRAPER_API_URL=http://scraper:8000/v2/scrape
SCRAPER_API_KEY=local-dev-key
# When SCRAPER_API_KEY is set, make up / docker compose auto-includes --profile scraper (Pulse Wire Reddit/YouTube fallback).
HLS_PUBLIC_BASE=http://localhost:8090
PUBLIC_ORIGIN=http://localhost:8090
PUBLIC_ORIGIN_WS=ws://localhost:8090
FRONTEND_ORIGIN=http://localhost:8090
CDN_PUBLIC_BASE=http://localhost:8090/emotes
CURATOR_API_TOKEN=dev-insecure-curator-token
MAX_RETAINED_MESSAGES=200
ALWAYS_TRACKED_CHANNELS=sodapoppin,xqc
AUTH_COOKIE_SECRET=dev-insecure-cookie-secret
TWITCH_DEV_TOKEN_IMPORT_ENABLED=true
SETUP_CONTROL_WAKE_ENABLED=true
TWITCH_AUTH_SCOPES=chat:read chat:edit user:read:follows
S3_ENDPOINT=http://minio:9000
S3_BUCKET=emotes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CLIPPER_WEBHOOK_TOKEN=
VITE_CLIPPER_TOKEN=

# Pulse Wire (story graph) — enabled in dev; storygraph service always runs in compose.
# Optional: STORYGRAPH_INGEST_INTERVAL=30s for faster first-run ingest (default 5m).
PULSE_WIRE_ENABLED=true
PULSE_WIRE_SEMANTIC=false
REDDIT_COMMERCIAL_OK=true
# Bounded scraper corroboration for Pulse Wire (Reddit 403 from Docker egress → browser fallback)
STORYGRAPH_SOCIAL_BROWSER_FETCH_BUDGET=2
STORYGRAPH_YOUTUBE_BROWSER_FETCH_BUDGET=1
# STORYGRAPH_SOCIAL_SCRAPE_USE_PROXY=true
SOCIAL_RETENTION_DAYS=90
STREAMERBANS_INGEST_ENABLED=true
# Dev-only: enables internal/storygraph/store integration tests (go test ./internal/storygraph/store/...).
# Must point at a dedicated DB — tests DROP SCHEMA public CASCADE. Not used by running services.
STORYGRAPH_STORE_TEST_DATABASE_URL=postgres://app:app@127.0.0.1:5432/streamclone_storygraph_test?sslmode=disable
