{
  "mcpServers": {
    "streamclone-codegraph": {
      "command": "wsl.exe",
      "args": ["--cd", "${workspaceFolder}", "bash", "scripts/codegraph-mcp.sh"]
    },
    "streamclone-data": {
      "command": "wsl.exe",
      "args": ["--cd", "${workspaceFolder}", "bash", "scripts/data-mcp.sh"]
    }
  }
}
