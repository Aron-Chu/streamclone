# Streamclone - Codex MCP (project layer). Generated by: make codex-setup
# Copy is written to config.toml with your machine paths (__REPO_WIN__ / __REPO_WSL__).

# Portal PRD ~62KB; live-coverage ~29KB — keep headroom for AGENTS + design docs
project_doc_max_bytes = 131072

# Essential MCP (mirrors .cursor/mcp.windows.json.example)
[mcp_servers.streamclone-codegraph]
command = "wsl.exe"
args = ["--cd", "__REPO_WIN__", "bash", "scripts/codex-mcp-launch.sh", "codegraph"]
startup_timeout_sec = 45
enabled = true

[mcp_servers.streamclone-stack]
command = "wsl.exe"
args = ["--cd", "__REPO_WIN__", "bash", "scripts/codex-mcp-launch.sh", "stack"]
startup_timeout_sec = 30
enabled = true

[mcp_servers.streamclone-data]
command = "wsl.exe"
args = ["--cd", "__REPO_WIN__", "bash", "scripts/codex-mcp-launch.sh", "data"]
startup_timeout_sec = 30
enabled = true

# Optional — enable for Twitch UI smoke; skip for backend/architecture reviews
[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@latest"]
startup_timeout_sec = 60
enabled = false

# Optional — extension Figma PNGs live in streamclone-pulse/docs/pulse-extension/figma/.
# If enabled globally in ~/.codex/config.toml, leave false here to avoid duplicate servers.
[mcp_servers.figma-bridge]
command = "node"
args = ["__REPO_WIN__\\scripts\\.figma-bridge-deps\\node_modules\\@gethopp\\figma-mcp-bridge\\dist\\index.js"]
startup_timeout_sec = 60
enabled = false
