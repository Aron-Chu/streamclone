# Streamclone Codex exec policies (project layer). Starlark — see https://developers.openai.com/codex/rules

# Destructive / irreversible
prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Never force-push master without explicit user request",
)

prefix_rule(
    pattern = ["make", "nuke"],
    decision = "forbidden",
    justification = "make nuke deletes volumes and shared data",
)

prefix_rule(
    pattern = ["make", "down-clean"],
    decision = "prompt",
    justification = "Removes compose volumes",
)

prefix_rule(
    pattern = ["docker", "volume", "rm"],
    decision = "prompt",
    justification = "Docker volume removal is destructive",
)

# Safe dev loops
prefix_rule(
    pattern = ["make", "up"],
    decision = "allow",
    justification = "Start local stack",
)

prefix_rule(
    pattern = ["make", "check-quick"],
    decision = "allow",
    justification = "Fast PR gate",
)

prefix_rule(
    pattern = ["make", "test"],
    decision = "allow",
    justification = "Go unit tests",
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = "Go tests",
)

# Pulse live-coverage review probes (read-only)
prefix_rule(
    pattern = ["curl"],
    decision = "allow",
    justification = "Health and pulse BFF probes",
)

prefix_rule(
    pattern = ["python"],
    decision = "allow",
    justification = "Pulse skill smoke scripts",
)

prefix_rule(
    pattern = ["make", "context-snapshots"],
    decision = "allow",
    justification = "Offline runtime context summaries",
)

prefix_rule(
    pattern = ["make", "codex-sync-skills"],
    decision = "allow",
    justification = "Refresh .agents/skills mirrors",
)

prefix_rule(
    pattern = ["bash", "scripts/mcp-preflight.sh"],
    decision = "allow",
    justification = "MCP stdio verification",
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "Commits need explicit user intent",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Push requires explicit user intent",
)
