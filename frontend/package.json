{
  "name": "streamclone-frontend",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "screenshots:readme": "playwright test e2e/readme-screenshots.spec.ts",
    "docs:media": "playwright test e2e/docs-media.spec.ts",
    "docs:media:analytics": "playwright test e2e/docs-media-analytics.spec.ts",
    "test:smoke": "npx playwright test e2e/smoke-core.spec.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.62.7",
    "hls.js": "1.5.20",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "zustand": "5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "8.0.16"
  }
}
