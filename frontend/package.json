{
  "name": "streamclone-frontend",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tailwindcss -i ./src/index.css -o ./.streamclone.css --minify && STREAMCLONE_CSS_ENTRY=.streamclone.css vite build",
    "preview": "vite preview",
    "screenshots:readme": "playwright test e2e/readme-screenshots.spec.ts",
    "docs:media": "playwright test e2e/docs-media.spec.ts",
    "docs:media:analytics": "playwright test e2e/docs-media-analytics.spec.ts",
    "test:smoke": "npx playwright test e2e/smoke-core.spec.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@streamclone/pulse-core": "file:../packages/pulse-core",
    "@tanstack/react-query": "5.101.0",
    "@tanstack/react-virtual": "^3.14.3",
    "hls.js": "1.6.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/node": "^22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.0.2",
    "autoprefixer": "10.5.0",
    "fast-check": "^4.8.0",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
