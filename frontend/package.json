{
  "name": "streamclone-frontend",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tailwindcss -i ./src/index.css -o ./.streamclone.css --minify && STREAMCLONE_CSS_ENTRY=.streamclone.css vite build",
    "preview": "vite preview",
    "screenshots:readme": "playwright test e2e/readme-screenshots.spec.ts",
    "docs:media": "playwright test e2e/docs-media.spec.ts",
    "docs:media:analytics": "playwright test e2e/docs-media-analytics.spec.ts",
    "test:smoke": "npx playwright test e2e/smoke-core.spec.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-virtual": "^3.14.10",
    "hls.js": "1.7.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.1.0",
    "autoprefixer": "10.5.4",
    "fast-check": "^4.9.0",
    "postcss": "8.5.26",
    "tailwindcss": "3.4.19",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  }
}
