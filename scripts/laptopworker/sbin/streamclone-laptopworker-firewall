#!/usr/bin/env bash
# Root-owned firewall helper (installed to /usr/local/sbin). Do not run from git checkout.
set -euo pipefail

if [ "${EUID:-$(id -u)}" -ne 0 ]; then
  echo "must run as root (installed helper)" >&2
  exit 1
fi

if [ "${1:-}" = "--verify" ]; then
  ok=0
  if iptables -L DOCKER-USER -n >/dev/null 2>&1 && iptables -S DOCKER-USER 2>/dev/null | grep -q 8090; then
    echo "DOCKER-USER :8090 ok"
  else
    echo "DOCKER-USER :8090 MISSING"; ok=1
  fi
  if iptables -S INPUT 2>/dev/null | grep -q 8090; then
    echo "INPUT :8090 ok"
  else
    echo "INPUT :8090 MISSING"; ok=1
  fi
  ufw status 2>/dev/null | head -3 || true
  exit "$ok"
fi

if ! command -v ufw >/dev/null 2>&1; then
  echo "==> Installing ufw..."
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq ufw
fi

if ! ip link show tailscale0 >/dev/null 2>&1; then
  echo "tailscale0 not found — is tailscaled up?" >&2
  exit 1
fi

echo "==> UFW baseline (SSH on tailscale0 only by default)"
ufw default deny incoming
ufw default allow outgoing
ufw allow in on tailscale0 to any port 22 proto tcp comment 'Tailscale SSH'

if [ "${LAPTOPWORKER_UFW_ALLOW_LAN_SSH:-}" = "1" ]; then
  echo "==> Opt-in: LAN SSH (LAPTOPWORKER_UFW_ALLOW_LAN_SSH=1)"
  ufw allow OpenSSH comment 'LAN SSH opt-in'
fi

ufw --force enable

echo "==> DOCKER-USER :8090 (lo + tailscale0)"
if iptables -L DOCKER-USER -n >/dev/null 2>&1; then
  if ! iptables -C DOCKER-USER -i lo -p tcp --dport 8090 -j ACCEPT 2>/dev/null; then
    iptables -I DOCKER-USER 1 -i lo -p tcp --dport 8090 -j ACCEPT
  fi
  if ! iptables -C DOCKER-USER -i tailscale0 -p tcp --dport 8090 -j ACCEPT 2>/dev/null; then
    iptables -I DOCKER-USER 2 -i tailscale0 -p tcp --dport 8090 -j ACCEPT
  fi
  if ! iptables -C DOCKER-USER -p tcp --dport 8090 -j DROP 2>/dev/null; then
    iptables -I DOCKER-USER 3 -p tcp --dport 8090 -j DROP
  fi
else
  echo "    DOCKER-USER chain missing (docker not up?) — skipping"
fi

echo "==> INPUT :8090 (lo + tailscale0; blocks LAN to docker-proxy)"
if ! iptables -C INPUT -i lo -p tcp --dport 8090 -j ACCEPT 2>/dev/null; then
  iptables -I INPUT 1 -i lo -p tcp --dport 8090 -j ACCEPT
fi
if ! iptables -C INPUT -i tailscale0 -p tcp --dport 8090 -j ACCEPT 2>/dev/null; then
  iptables -I INPUT 2 -i tailscale0 -p tcp --dport 8090 -j ACCEPT
fi
if ! iptables -C INPUT -p tcp --dport 8090 -j DROP 2>/dev/null; then
  iptables -A INPUT -p tcp --dport 8090 -j DROP
fi

ufw status verbose
echo "Firewall applied."
