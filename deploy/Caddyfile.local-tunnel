:80 {
	encode zstd gzip

	@chat_local {
		host localhost 127.0.0.1
		path /v1/auth* /v1/me /v1/me/followed /v1/logout /v1/ws
	}
	reverse_proxy @chat_local chat:8080 {
		header_up X-Forwarded-Proto http
		header_up X-Forwarded-Host {http.request.header.Host}
	}

	@chat {
		path /v1/auth* /v1/me /v1/me/followed /v1/logout /v1/ws
	}
	reverse_proxy @chat chat:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host {http.request.header.Host}
	}

	@video {
		path /v1/stream /v1/stream/*
	}
	reverse_proxy @video video:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-For {http.request.remote.host}
		transport http {
			read_timeout 2m
			write_timeout 2m
			response_header_timeout 2m
		}
	}

	@emote {
		path /v1/channels/*/emotes /v1/channels/*/emotes/* /v1/emotes* /v1/sets* /v1/seed*
	}
	reverse_proxy @emote emote:8080 {
		header_up X-Forwarded-Proto https
	}

	@emote_assets {
		path /emotes/*
	}
	reverse_proxy @emote_assets emote:8080 {
		header_up X-Forwarded-Proto https
	}

	@analytics {
		path_regexp analytics ^/v1/(analytics|extension|pulse|public|portal)(/|$)
	}
	reverse_proxy @analytics analytics:8080 {
		header_up X-Forwarded-Proto https
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	@internal_replayforge_jobs {
		method POST
		path /v1/internal/replayforge/jobs/*
	}
	reverse_proxy @internal_replayforge_jobs analytics:8080 {
		header_up X-Forwarded-Proto https
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	@hls {
		path /live/*
	}
	reverse_proxy @hls mediamtx:8888 {
		header_up X-Forwarded-Proto {http.request.scheme}
		header_up Authorization "Bearer streamclone-local-hls-cdn"
	}

	@setup_control {
		path /v1/setup-control /v1/setup-control/*
	}
	route @setup_control {
		uri strip_prefix /v1/setup-control
		reverse_proxy host.docker.internal:9191 {
			header_up X-Forwarded-Proto http
			transport http {
				read_timeout 15m
				write_timeout 15m
				response_header_timeout 15m
			}
		}
	}

	@clipper {
		path /v1/clipper /v1/clipper/*
	}
	route @clipper {
		uri replace /v1/clipper /v1
		reverse_proxy host.docker.internal:8095 {
			header_up X-Forwarded-Proto https
		}
	}

	@metadata {
		path /v1/*
	}
	reverse_proxy @metadata metadata:8080 {
		header_up X-Forwarded-Proto https
	}

	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto https
	}
}
