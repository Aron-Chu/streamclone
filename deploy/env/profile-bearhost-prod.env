# BearHost VPS production — merge with profile-full.env + profile-archive.env
# Host: 141.11.243.103 (IP-only HTTP until DNS + ACME cutover)

APP_DOMAIN=141.11.243.103
PUBLIC_ORIGIN=http://141.11.243.103
ACME_EMAIL=placeholder@example.com
ADMIN_ARCHIVE_ENABLED=1
STREAMCLONE_SECRETS_DIR=/etc/streamclone/secrets
ARCHIVE_AZURE_CONNECTION_STRING_FILE=/run/streamclone-secrets/azure-archive-connection-string

SCRAPER_USE_IMAGES=0
BEARHOST_BUILD_LOCAL=1
IMAGE_TAG=latest
SCRAPER_EPHEMERAL_BROWSER=false

# Worker concurrency caps (8 GB VPS — from profile-azure-workers.env)
SCRAPER_MAX_CONCURRENT=1
SCRAPER_BROWSER_POOL_SIZE=1
BRONZE_TT_SUMMARY_CONCURRENCY=2
ANALYTICS_VOD_GQL_CONCURRENCY=1
ANALYTICS_VOD_GQL_CONCURRENCY_MIN=1
ANALYTICS_VOD_GQL_CONCURRENCY_MAX=1
MAX_CONCURRENT_TRACKED_CHANNELS=200
BRONZE_TOP_N=500

# Corpus plane — enable only after bearhost-corpus-preflight passes (gate 0)
CORPUS_WORKERS_ENABLED=0
