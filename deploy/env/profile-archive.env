# Streamclone archive / backfill profile overlay
# Merge with core stack for Azure-backed analytics durability.
# Credentials: ARCHIVE_AZURE_CONNECTION_STRING_FILE points at a local file (never commit).

ARCHIVE_ENABLED=true
ARCHIVE_STORAGE_PROVIDER=azure
ARCHIVE_PRIMARY_PROVIDER=azure
ARCHIVE_READ_THROUGH=false
ARCHIVE_DUAL_WRITE=false
ARCHIVE_AZURE_STORAGE_ACCOUNT=ststreamclone3lf6tt
ARCHIVE_AZURE_CONTAINER=streamclone-archive
ARCHIVE_AZURE_PREFIX=streamclone
# Example: C:/Users/you/.streamclone/azure-archive-connection-string
ARCHIVE_AZURE_CONNECTION_STRING_FILE=
ARCHIVE_PROTECT_RETENTION=true
ARCHIVE_EXPORT_ON_SYNC=true
ARCHIVE_EXPORT_INTERVAL=1h
ARCHIVE_PG_DUMP_NIGHTLY=true

TIER0_ENABLED=true
TIER0_SAMPLE_INTERVAL=45s
TIER0_ROSTER_INTERVAL=5m
TIER0_ROSTER_TOP_N=200
MAX_CONCURRENT_TRACKED_CHANNELS=200

BACKFILL_ENABLED=true
BACKFILL_WORKER_INTERVAL=30s
POST_END_WAIT_MIN=10m
POST_END_WAIT_MAX=30m
POST_END_COVERAGE_PCT=70
# Match ANALYTICS_TRACKER_SCRAPE_TIMEOUT_MS default; silver post-end TT scrape uses ttSyncTimeoutMS.
ANALYTICS_TT_SYNC_TIMEOUT_MS=120000

GOLD_BACKFILL_ENABLED=true
GOLD_MIN_PEAK_VIEWERS=0
GOLD_MIN_DURATION_MINUTES=0
GOLD_ENQUEUER_INTERVAL=5m
GOLD_SYNC_TIMEOUT_MS=600000

BRONZE_TT_SUMMARY_CONCURRENCY=4
