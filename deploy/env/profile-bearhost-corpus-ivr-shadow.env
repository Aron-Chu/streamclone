# PROD_SHADOW_CANARY_ONLY — merge after profile-bearhost-corpus.env on BearHost corpus host.
# Non-mutating IVR shadow: artifacts only; GQL remains canonical. No lite/peaks writes.
# Roll back by removing this overlay and recreating analytics-workers.
#
# Do NOT merge into profile-bearhost-pulse.env (live API mode keeps GOLD_BACKFILL off).

GOLD_IVR_ENABLED=true
GOLD_IVR_SHADOW_MODE=true
GOLD_IVR_LITE_ENABLED=false
GOLD_IVR_PEAKS_ONLY_ENABLED=false
GOLD_IVR_CANONICAL_REPLACE=false
GOLD_IVR_ENABLED_CHANNEL_ALLOWLIST=ludwig
GOLD_IVR_SHADOW_ARTIFACT_DIR=runtime/ivr-shadow
GOLD_IVR_SHADOW_ARTIFACT_RETENTION_DAYS=7
GOLD_IVR_SHADOW_ARTIFACT_MAX_FILES=1000
