# Isolated Pulse staging stack — localhost :8091 only (no Cloudflare route).
# Merge after profile-bearhost-prod.env; NEVER merge into profile-bearhost-pulse.env (production).

COMPOSE_PROJECT_NAME=streamclone-pulse-staging

PUBLIC_ORIGIN=http://127.0.0.1:8091
APP_DOMAIN=127.0.0.1

PULSE_HOSTED_MODE=true
PULSE_MAX_ACTIVE_CHANNELS=25
PULSE_MAX_BACKFILLS=1
PULSE_MAX_ALWAYS_TRACKED_PER_PRINCIPAL=10
MAX_CONCURRENT_TRACKED_CHANNELS=25

# Staging uses same beta keys as production secrets file on VPS (operator-provided).
# PULSE_BETA_KEYS loaded from /etc/streamclone/secrets/pulse-beta.env by up script.

STREAMCLONE_VERSION=v0.3.0-rc4
