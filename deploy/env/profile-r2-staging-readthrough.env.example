# Local/staging ONLY — merge with profile-core + profile-archive for read-through canary.
# NEVER merge hosted production archive overlays from private streampulse-ops.
#
# Requires secret files (never commit):
#   ARCHIVE_AZURE_CONNECTION_STRING_FILE=~/.streamclone/azure-archive-connection-string
#   ARCHIVE_R2_ACCESS_KEY_ID_FILE=~/.streamclone/r2-access-key-id
#   ARCHIVE_R2_SECRET_ACCESS_KEY_FILE=~/.streamclone/r2-secret-access-key
#
# Replay drill: bash scripts/storage/r2-restore-drill.sh

ARCHIVE_PRIMARY_PROVIDER=azure
ARCHIVE_READ_THROUGH=true
ARCHIVE_DUAL_WRITE=false
ARCHIVE_R2_BUCKET=streampulse-artifacts-staging
ARCHIVE_R2_ACCOUNT_ID=51dd8007b22ac92482388d8b6cdbb6e3
ARCHIVE_R2_PREFIX=archive
ARCHIVE_R2_ENDPOINT=https://51dd8007b22ac92482388d8b6cdbb6e3.r2.cloudflarestorage.com
# Set file paths locally; do not commit credentials:
ARCHIVE_R2_ACCESS_KEY_ID_FILE=
ARCHIVE_R2_SECRET_ACCESS_KEY_FILE=
