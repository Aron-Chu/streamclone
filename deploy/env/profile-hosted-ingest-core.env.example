# StreamPulse hosted — ingest-core Phase D (250/250 behavior-equivalent)
# Phase C shadow profile: deploy/env/profile-hosted-ingest-core-phase-c.env.example
# Prefer: IMAGE_TAG=v0.3.0-rc24 bash scripts/ingest-phase-d-enable.sh
# (forces INGEST_CORE_ENABLED=1). Do NOT enable tiering on first cutover.

INGEST_CORE_ENABLED=1
INGEST_CORE_DUAL_READ_MODE=0
INGEST_CORE_SHADOW_MODE=0
INGEST_TIERING_ENABLED=0

HUB_ROSTER_LIMIT=250
MAX_ACTIVE_IRC_CHANNELS=250
PULSE_MAX_ACTIVE_CHANNELS=250
PULSE_LIVE_ADMISSION_ENABLED=true
PULSE_LIVE_ADMISSION_TOP_N=250
PULSE_LIVE_ADMISSION_SOURCE=roster_then_helix
PULSE_LIVE_ADMISSION_INTERVAL=15s

# Hot-path isolation (corpus not required on API node)
CORPUS_WORKERS_ENABLED=0
SCRAPER_ENABLED_ON_API_NODE=0
SCRAPER_MAX_CONCURRENT=1
BACKFILL_MAX_PARALLEL_STREAMS=1
PULSE_MAX_BACKFILLS=1

# Ingest-core tuning (defaults; safe when disabled)
INGEST_SHARD_COUNT=32
INGEST_IRC_QUEUE_SIZE=8192
INGEST_P0_QUEUE_RESERVE=2048
INGEST_FLUSH_INTERVAL=3s
INGEST_FLUSH_MAX_BATCH=500
INGEST_OPEN_MINUTE_FLUSH_INTERVAL=5s

# Redis pool
REDIS_POOL_SIZE=32
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# --- Phase E ops flip (SEPARATE deploy; do not merge with first cutover) ---
# RAM-save path (500 roster, 50 IRC + tiering):
# INGEST_TIERING_ENABLED=1
# HUB_ROSTER_LIMIT=500
# MAX_ACTIVE_IRC_CHANNELS=50
# PULSE_MAX_ACTIVE_CHANNELS=50
# PULSE_LIVE_ADMISSION_TOP_N=500
# INGEST_P1_HOT_LIMIT=50
# TIER0_ENABLED=1
# TIER0_ROSTER_TOP_N=500
# Script: scripts/ingest-phase-e-enable.sh
#
# Recommended coverage scale (500 roster, 250 IRC, tiering off):
# INGEST_TIERING_ENABLED=0
# HUB_ROSTER_LIMIT=500
# MAX_ACTIVE_IRC_CHANNELS=250
# PULSE_MAX_ACTIVE_CHANNELS=250
# PULSE_LIVE_ADMISSION_TOP_N=500
# TIER0_ENABLED=1
# TIER0_ROSTER_TOP_N=500
# Script: scripts/ingest-phase-e-250-enable.sh
