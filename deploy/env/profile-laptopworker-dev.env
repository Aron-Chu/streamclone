# Laptopworker dev hub — UI + secrets on tailnet; network-heavy scrape/corpus stays off this host.
# Merge via .env.local on laptopworker (see scripts/laptopworker-bootstrap.sh).

STREAMCLONE_DISABLE_LOCAL_SCRAPER=true

# Corpus / backfill workers are not part of the core laptopworker stack.
TIER0_ENABLED=false
BRONZE_ENABLED=false
BACKFILL_ENABLED=false
GOLD_BACKFILL_ENABLED=false
ARCHIVE_ENABLED=false
ARCHIVE_EXPORT_ON_SYNC=false

# Tailscale MagicDNS — browse UI from desktop: http://laptopworker:8090
HLS_PUBLIC_BASE=http://laptopworker:8090
PUBLIC_ORIGIN=http://laptopworker:8090
FRONTEND_ORIGIN=http://laptopworker:8090

# Host secrets dir — value injected at merge by scripts/laptopworker-env.sh ($HOME/.streamclone/secrets).
