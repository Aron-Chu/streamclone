# Laptopworker dev hub — UI + secrets on tailnet; network-heavy scrape/corpus stays on legacy-rollback-host.
# Merge via .env.local on laptopworker (see scripts/laptopworker-bootstrap.sh).

STREAMCLONE_DISABLE_LOCAL_SCRAPER=true

# Pulse Wire storygraph ingest (Reddit/LSF/social) — network-heavy; off on laptopworker.
PULSE_WIRE_ENABLED=false
PULSE_WIRE_SEMANTIC=false
STORYGRAPH_SOCIAL_BROWSER_FETCH_BUDGET=0
STORYGRAPH_YOUTUBE_BROWSER_FETCH_BUDGET=0

# Corpus / backfill workers run on VPS only (bearhost-corpus-only / analytics-workers).
TIER0_ENABLED=false
BRONZE_ENABLED=false
BACKFILL_ENABLED=false
GOLD_BACKFILL_ENABLED=false
ARCHIVE_ENABLED=false
ARCHIVE_EXPORT_ON_SYNC=false

# Tailscale MagicDNS — browse UI from desktop: http://laptopworker:8090
HLS_PUBLIC_BASE=http://laptopworker:8090
PUBLIC_ORIGIN=http://laptopworker:8090
FRONTEND_ORIGIN=http://laptopworker:8090

# Host secrets dir — value injected at merge by scripts/laptopworker-env.sh ($HOME/.streamclone/secrets).

# Production scrape / corpus API (read-only dev reference; no local scraper profile).
STREAMPULSE_PUBLIC_API=https://api.streampulse.stream
