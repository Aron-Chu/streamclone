# StreamPulse hosted — ingest-core Phase C shadow (legacy writes PG)
# Copy into streampulse-ops analytics overlay ONLY after Step 0 baseline + Step 1 preconditions pass.
# Do NOT set INGEST_CORE_ENABLED=1 during Phase C.

INGEST_CORE_ENABLED=0
INGEST_CORE_DUAL_READ_MODE=1
INGEST_CORE_SHADOW_MODE=1
INGEST_TIERING_ENABLED=0

HUB_ROSTER_LIMIT=250
MAX_ACTIVE_IRC_CHANNELS=250
PULSE_MAX_ACTIVE_CHANNELS=250
PULSE_LIVE_ADMISSION_ENABLED=true
PULSE_LIVE_ADMISSION_TOP_N=250

# Staged allowlist (optional first hour); remove for full 250 shadow
# INGEST_SHADOW_CHANNEL_ALLOWLIST=xqc,ludwig,tarik,kaicenat

CORPUS_WORKERS_ENABLED=0
SCRAPER_ENABLED_ON_API_NODE=0
SCRAPER_MAX_CONCURRENT=1
BACKFILL_MAX_PARALLEL_STREAMS=1
PULSE_MAX_BACKFILLS=1

INGEST_SHADOW_ARTIFACT_DIR=runtime/ingest-shadow
INGEST_SHADOW_TOLERANCE_CHAT_PCT=2

INGEST_SHARD_COUNT=32
INGEST_IRC_QUEUE_SIZE=8192
INGEST_P0_QUEUE_RESERVE=2048
INGEST_FLUSH_INTERVAL=5s
INGEST_FLUSH_MAX_BATCH=500
INGEST_OPEN_MINUTE_FLUSH_INTERVAL=10s

REDIS_POOL_SIZE=32
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s
