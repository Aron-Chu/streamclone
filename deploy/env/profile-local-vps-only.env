# Local UI only — Tier-0 / Bronze / backfill / scraper run on legacy-rollback-host.
# Merge via .env.local or: make local-vps-only

STREAMCLONE_DISABLE_LOCAL_SCRAPER=1

TIER0_ENABLED=false
BRONZE_ENABLED=false
BACKFILL_ENABLED=false
GOLD_BACKFILL_ENABLED=false

# Avoid duplicate Azure corpus writes from dev Postgres
ARCHIVE_EXPORT_ON_SYNC=false
ARCHIVE_PG_DUMP_NIGHTLY=false
