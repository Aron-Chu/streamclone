# Mode A — Azure VM scraper-only stack (Camoufox + optional Flame proxy).
# PROXY_* belong in VM .env.local only — never commit credentials.
# Map Flame premium per deploy/env/proxy-flame.env.example.

SCRAPER_MAX_CONCURRENT=1
SCRAPER_BROWSER_POOL_SIZE=1
SCRAPER_EPHEMERAL_BROWSER=false
SCRAPER_USE_IMAGES=1
IMAGE_TAG=latest

# PROXY_* in VM .env.local only — see deploy/env/proxy-flame.env.example
