# BearHost headless corpus — auto silver after bronze (merge with profile-archive + profile-bearhost-prod)
#
# Runs on VPS 24/7; your PC can be off. Uses VPS bandwidth (not home ISP).
#
# Depth budget (conservative defaults ~few GB/month silver scrape):
#   Bronze: up to ~80 Helix VOD listings per channel (metadata only, light)
#   Silver: TT per-stream viewer charts for streams within SILVER_ENQUEUE_SINCE_DAYS
#   Gold:   OFF by default (GQL chat is heavy — enable only for favorites)

SILVER_AUTO_ENQUEUE_ENABLED=true
SILVER_ENQUEUE_SINCE_DAYS=45
SILVER_ENQUEUE_TOP_N=100
SILVER_ENQUEUE_MAX_PER_RUN=20
SILVER_ENQUEUE_INTERVAL=15m

# Keep gold off until silver fleet is caught up (saves bandwidth + scraper time)
GOLD_BACKFILL_ENABLED=false

# No always-on live IRC tracking on corpus VPS
ALWAYS_TRACKED_CHANNELS=

# One TT scrape at a time on 8 GB VPS
SCRAPER_MAX_CONCURRENT=1
