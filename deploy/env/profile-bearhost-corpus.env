# BearHost headless corpus — bronze + silver auto-enqueue (merge after profile-bearhost-prod).
#
# Use with: bash scripts/bearhost-corpus-only.sh  (or make bearhost-corpus-only)
# Runs on VPS 24/7; stops video/mediamtx/frontend/caddy to free RAM for scraper.
#
# Depth budget (conservative defaults ~few GB/month silver scrape):
#   Bronze: up to ~80 Helix VOD listings per channel (metadata only, light)
#   Silver: TT per-stream viewer charts for streams within SILVER_ENQUEUE_SINCE_DAYS
#   Gold:   selective GQL VOD chat (peak ≥5k or duration ≥60m); shares queue with silver

# Enable analytics-workers corpus plane (still requires bearhost-corpus-preflight PASS)
CORPUS_WORKERS_ENABLED=1
BRONZE_ENABLED=true
BACKFILL_ENABLED=true
ARCHIVE_ENABLED=true

# Bronze roster from metadata; skip live Tier-0 IRC sampling on corpus VPS
TIER0_ENABLED=false

SILVER_AUTO_ENQUEUE_ENABLED=true
SILVER_ENQUEUE_SINCE_DAYS=45
SILVER_ENQUEUE_TOP_N=100
SILVER_ENQUEUE_MAX_PER_RUN=40
SILVER_ENQUEUE_INTERVAL=5m

# Gold: selective GQL chat — silver and gold workers run concurrently in analytics-workers.
# Auto-enqueue only for silver-confirmed streams passing peak/duration gates.
GOLD_BACKFILL_ENABLED=true
BACKFILL_GOLD_WORKER_ENABLED=true
BACKFILL_WORKER_INTERVAL=5s
BACKFILL_STALE_RUNNING_AFTER=2h
BACKFILL_HEARTBEAT_INTERVAL=60s
GOLD_MIN_PEAK_VIEWERS=5000
GOLD_MIN_DURATION_MINUTES=60
GOLD_ENQUEUER_INTERVAL=15m
GOLD_SYNC_TIMEOUT_MS=600000
GOLD_FULL_ENABLED=true
GOLD_FULL_OPERATOR_ONLY=true

# Low concurrency on 8 GB VPS (also set in profile-bearhost-prod.env).
# Raise GQL to 2 only after Grafana shows low throttle/backoff.
ANALYTICS_VOD_GQL_CONCURRENCY=1
ANALYTICS_VOD_GQL_CONCURRENCY_MIN=1
ANALYTICS_VOD_GQL_CONCURRENCY_MAX=1

# No always-on live IRC tracking on corpus VPS; add favorite logins for forced gold
ALWAYS_TRACKED_CHANNELS=

# One TT scrape at a time on 8 GB VPS
SCRAPER_MAX_CONCURRENT=1

# Prefer scraper HTML cache + backoff after CF failures (see ANALYTICS_TT_SCRAPE_BACKOFF_ENABLED).
ANALYTICS_PASS_TT_MAXAGE=true
ANALYTICS_TT_SCRAPE_BACKOFF_ENABLED=true
