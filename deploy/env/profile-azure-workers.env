# Mode B — Azure archive plane workers (merge with profile-archive.env on VM).
# DATABASE_URL / REDIS_URL / METADATA_SERVICE_URL target Azure-local compose services.

DATABASE_URL=postgres://app:app@postgres:5432/streamclone?sslmode=disable
REDIS_URL=redis://redis:6379/0
METADATA_SERVICE_URL=http://metadata:8080
SCRAPER_API_URL=http://scraper:8000/v2/scrape

TIER0_ENABLED=true
TIER0_ROSTER_TOP_N=200
BRONZE_ENABLED=true
BRONZE_TOP_N=500
BACKFILL_ENABLED=true
GOLD_BACKFILL_ENABLED=true

SCRAPER_MAX_CONCURRENT=1
SCRAPER_BROWSER_POOL_SIZE=1
BRONZE_TT_SUMMARY_CONCURRENCY=2
ANALYTICS_VOD_GQL_CONCURRENCY=1
ANALYTICS_VOD_GQL_CONCURRENCY_MIN=1
ANALYTICS_VOD_GQL_CONCURRENCY_MAX=1
MAX_CONCURRENT_TRACKED_CHANNELS=200

ARCHIVE_ENABLED=true
ARCHIVE_STORAGE_PROVIDER=azure
ARCHIVE_PG_DUMP_NIGHTLY=true
# Connection string file on VM host — mounted into analytics-workers at /run/streamclone-secrets/
ARCHIVE_AZURE_CONNECTION_STRING_FILE=/run/streamclone-secrets/azure-archive-connection-string
STREAMCLONE_SECRETS_DIR=

SCRAPER_USE_IMAGES=1
IMAGE_TAG=latest

# Reserved cap for future backfill throttle (not yet read by analytics config).
# TT_BACKFILL_MAX_PER_HOUR=5
