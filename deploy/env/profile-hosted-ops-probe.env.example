# Operator probe token (streampulse-ops overlay)
# Required for /v1/internal/ops/* on hosted production.

PULSE_OPS_PROBE_TOKEN=
# Or mount a secret file:
# PULSE_OPS_PROBE_TOKEN_FILE=/run/secrets/pulse_ops_probe_token

# Hosted production: keep false (see docs/pulse-extension/infra-004-access-setup-runbook.md)
PULSE_ADMIN_LOCAL_BYPASS=false

# Align container health version with promoted IMAGE_TAG (not host checkout VERSION file)
STREAMCLONE_VERSION=v0.3.0-rc18

# Optional: daily terminal backfill job prune (analytics API process only)
# HOSTED_RETENTION_PRUNE_ENABLED=true
# HOSTED_BACKFILL_JOB_RETENTION_DAYS=30
