# Flame Proxies residential — copy to .env.local (never commit live passwords).

# Dashboard: https://flameproxies.com/dashboard/api-docs

# Reseller API base: https://rapi.flashproxy.com/api/v1 (Bearer PROXY_API_KEY)

#

# API key (fp_live_* production, fp_test_* sandbox)

# PROXY_API_KEY=

# PROXY_API_BASE_URL=https://rapi.flashproxy.com/api/v1

# Optional explicit plan UUIDs (else auto-matched from GET /plans)

# PROXY_FLAME_PLAN_PREMIUM_ID=

# PROXY_FLAME_PLAN_BUDGET_ID=

#

# Premium package (benchmark profile: premium / api_premium)

PROXY_FLAME_PREMIUM_SERVER=http://proxy.flameproxies.com:8989

PROXY_FLAME_PREMIUM_USERNAME=your-flame-user-package-premium

PROXY_FLAME_PREMIUM_PASSWORD=your-password

#

# Budget package (benchmark profile: budget / api_budget)

PROXY_FLAME_BUDGET_SERVER=http://proxy.flameproxies.com:8989

PROXY_FLAME_BUDGET_USERNAME=your-flame-user

PROXY_FLAME_BUDGET_PASSWORD=your-password

#

# Optional: apply one profile to the running scraper container (same vars as compose)

# PROXY_SERVER=http://proxy.flameproxies.com:8989

# PROXY_USERNAME=your-flame-user-package-premium

# PROXY_PASSWORD=your-password
