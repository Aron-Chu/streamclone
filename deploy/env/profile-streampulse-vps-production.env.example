# StreamPulse VPS production profile (copy to profile-streampulse-vps-production.local.env).
# Secrets (Twitch OAuth, scraper key, pulse beta keys) belong in /etc/streamclone/secrets
# or .env on the VPS — never commit real values.

PUBLIC_ORIGIN=https://api.streampulse.stream
APP_DOMAIN=api.streampulse.stream

# Live Pulse plane in analytics API container
TIER0_ENABLED=true
PULSE_HOSTED_MODE=true
PULSE_MAX_ACTIVE_CHANNELS=10
PULSE_MAX_BACKFILLS=1
MAX_CONCURRENT_TRACKED_CHANNELS=10
CORPUS_WORKERS_ENABLED=0

# Single corpus worker canary (analytics-workers service)
BACKFILL_ENABLED=true
GOLD_BACKFILL_ENABLED=true
BACKFILL_GOLD_WORKER_COUNT=1
BACKFILL_SILVER_WORKER_COUNT=1
GOLD_VOD_SEGMENTS_ENABLED=true
ANALYTICS_VOD_GQL_CONCURRENCY=2
ANALYTICS_VOD_GQL_CONCURRENCY_MAX=4
SCRAPER_MAX_CONCURRENT=1

STREAMCLONE_VERSION=v0.3.0-rc4
EMOTE_SERVICE_URL=http://emote:8080
CDN_PUBLIC_BASE=https://api.streampulse.stream/emotes

# Local SoT — do not point at BearHost tailnet hosts
DATABASE_URL=postgres://app:CHANGE_ME@postgres:5432/streamclone?sslmode=disable
REDIS_URL=redis://redis:6379/0
