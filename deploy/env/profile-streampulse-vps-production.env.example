# StreamPulse VPS production profile (copy to profile-streampulse-vps-production.local.env).
# Secrets (Twitch OAuth, scraper key, pulse beta keys) belong in /etc/streamclone/secrets
# or .env on the VPS — never commit real values.

PUBLIC_ORIGIN=https://api.streampulse.stream
APP_DOMAIN=api.streampulse.stream

# Live Pulse plane in analytics API container
TIER0_ENABLED=true
PULSE_HOSTED_MODE=true
PULSE_MAX_ACTIVE_CHANNELS=10
PULSE_MAX_BACKFILLS=1
MAX_CONCURRENT_TRACKED_CHANNELS=10
CORPUS_WORKERS_ENABLED=0

# Single corpus worker canary (analytics-workers service)
BACKFILL_ENABLED=true
GOLD_BACKFILL_ENABLED=true
BACKFILL_GOLD_WORKER_COUNT=1
BACKFILL_SILVER_WORKER_COUNT=1
GOLD_VOD_SEGMENTS_ENABLED=true
ANALYTICS_VOD_GQL_CONCURRENCY=2
ANALYTICS_VOD_GQL_CONCURRENCY_MAX=4
SCRAPER_MAX_CONCURRENT=1

STREAMCLONE_VERSION=v0.3.0-rc4
EMOTE_SERVICE_URL=http://emote:8080
CDN_PUBLIC_BASE=https://api.streampulse.stream/emotes

# Emote blob storage — also set in VPS .env (emote service env_file). Defaults match compose minio.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=emotes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Do not set bucket-wide public read when archive/ shares the bucket (R2 dual-write).
S3_PUBLIC_READ=false

# Live IRC collector admission — off by default until soak; hub shows partial coverage honestly.
# These keys are interpolated into the analytics API container by the production compose overlay.
# Go reads PULSE_TOP500_*; PULSE_TOP_ROSTER_* is accepted as a legacy alias.
# PULSE_MAX_ACTIVE_CHANNELS also drives MAX_CONCURRENT_TRACKED_CHANNELS in the overlay.
PULSE_TOP500_ADMISSION_ENABLED=false
PULSE_TOP500_ADMISSION_TOP_N=100
PULSE_TOP500_ADMISSION_INTERVAL=60s
TOP500_METADATA_ENABLED=false
TOP500_METADATA_DRY_RUN=true
TOP500_METADATA_WRITE_ENABLED=false
TOP500_METADATA_TOP_N=100
TOP500_METADATA_LIVE_INTERVAL=60s
TOP500_METADATA_BATCH_SIZE=100
CORPUS_TARGET_TOP_N=0
# PULSE_MAX_ACTIVE_CHANNELS=200
# MAX_CONCURRENT_TRACKED_CHANNELS=200

# Operator auth for /v1/internal/corpus/* and /v1/admin/archive/*
ADMIN_ARCHIVE_ENABLED=1
ADMIN_ARCHIVE_REQUIRE_TOKEN=true

# Local SoT — do not point at BearHost tailnet hosts
DATABASE_URL=postgres://app:CHANGE_ME@postgres:5432/streamclone?sslmode=disable
REDIS_URL=redis://redis:6379/0
