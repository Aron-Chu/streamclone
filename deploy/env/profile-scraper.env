# Scraper profile — TwitchTracker charts via streamclone-scraper sibling repo
SCRAPER_API_URL=http://scraper:8000/v2/scrape
# Windows / Docker Desktop: ephemeral browser avoids pooled-profile deadlocks
SCRAPER_EPHEMERAL_BROWSER=true
SCRAPER_MAX_CONCURRENT=1
SCRAPER_BROWSER_POOL_SIZE=1
SCRAPER_HEADLESS=true
