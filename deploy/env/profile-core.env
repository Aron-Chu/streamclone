# Core profile — directory, playback, chat, emotes, Helix/VOD analytics only.
# Minute-level TwitchTracker charts need Analytics tier (scraper profile); see docs/install-desktop.md.
TWITCH_DEV_TOKEN_IMPORT_ENABLED=true
TWITCH_AUTH_SCOPES=chat:read chat:edit user:read:follows clips:edit
ALWAYS_TRACKED_CHANNELS=sodapoppin,xqc
# direct_hls first: ~2-4s relay start; streamlink-first waits 15s probe timeout before fallback.
STREAM_WORKER_BACKENDS=direct_hls,streamlink
