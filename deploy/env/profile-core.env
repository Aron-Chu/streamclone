# Core profile — directory, playback, chat, emotes, Helix/VOD analytics only.
# Minute-level charts: hosted StreamPulse (desktop install excludes scraper).
# TWITCH_DEV_TOKEN_IMPORT_ENABLED comes from profile-dev.env (dev) or release-bundle.env (false in releases).
TWITCH_AUTH_SCOPES=chat:read chat:edit user:read:follows clips:edit
ALWAYS_TRACKED_CHANNELS=sodapoppin,xqc
# direct_hls first: ~2-4s relay start; streamlink-first waits 15s probe timeout before fallback.
STREAM_WORKER_BACKENDS=direct_hls,streamlink
# Resource governor — caps concurrent video relays (0 = use MAX_CONCURRENT_STREAMS from merged .env).
MAX_CONCURRENT_RELAYS=0
MAX_CONCURRENT_STREAMS=20
# ReplayForge (optional, outside compose): API :8095, UI :8096 — see docs/agents-streamclone-and-replayforge.md
CLIPPER_SERVICE_URL=http://host.docker.internal:8095
VITE_REPLAYFORGE_UI_URL=http://localhost:8096
