# BearHost remote silver worker → streampulse-vps Postgres/Redis (Tailscale).
# Copy to profile-bearhost-corpus-remote-worker.local.env and fill secrets from VPS/BearHost.

# streampulse-vps tailnet IP (tailscale ip -4 on VPS)
STREAMPULSE_VPS_TAILNET_IP=100.67.17.74

DATABASE_URL=postgres://app:CHANGE_ME@${STREAMPULSE_VPS_TAILNET_IP}:5432/streamclone?sslmode=disable
REDIS_URL=redis://${STREAMPULSE_VPS_TAILNET_IP}:6379/0

# Reuse BearHost Twitch/scraper creds (copy from BearHost .env)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

SCRAPER_MAX_CONCURRENT=1
BACKFILL_SILVER_WORKER_COUNT=1
SILVER_AUTO_ENQUEUE_ENABLED=true
SILVER_ENQUEUE_SINCE_DAYS=60
SILVER_ENQUEUE_TOP_N=200
SILVER_ENQUEUE_MAX_PER_RUN=25
SILVER_ENQUEUE_INTERVAL=15m

# Optional: set true to drain Gold on BearHost instead of silver-only overlay defaults
# GOLD_BACKFILL_ENABLED=true
# BACKFILL_GOLD_WORKER_ENABLED=true
# GOLD_VOD_SEGMENTS_ENABLED=true
# ANALYTICS_VOD_GQL_CONCURRENCY=1
