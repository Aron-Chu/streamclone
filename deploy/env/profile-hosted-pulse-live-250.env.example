# StreamPulse hosted — top-250 live IRC tracking (CPU relief)
# Copy into streampulse-ops analytics overlay (e.g. profile-bearhost-pulse.env).
# Requires analytics container recreate/restart so in-memory collector drops 500→250.

# Hard cap: max simultaneous IRC websocket tracks
PULSE_MAX_ACTIVE_CHANNELS=250
MAX_ACTIVE_IRC_CHANNELS=250

# Live admission: Helix top-live by viewer order (must match cap)
PULSE_TOP500_ADMISSION_ENABLED=true
PULSE_TOP500_ADMISSION_TOP_N=250
PULSE_TOP500_ADMISSION_SOURCE=helix_top_live
PULSE_TOP500_ADMISSION_INTERVAL=60s
# Optional for stream-start validation channels: tighten to 30s (more Helix/IRC churn).
# PULSE_TOP500_ADMISSION_INTERVAL=30s
LIVE_ADMISSION_TOP_N=250

# Legacy alias (some ops overlays still read this)
MAX_CONCURRENT_TRACKED_CHANNELS=250

# Unchanged — metadata roster size ≠ IRC join count
# CORPUS_TARGET_TOP_N=1000
# TOP500_METADATA_TOP_N=1000

# Helix viewer poll interval (keep 15s; bindStreamIDNow + flushOpenMinuteToStore cover admit gap)
# ANALYTICS_POLL_INTERVAL=15s

# Protect / always-track channels that must IRC+Helix from minute 0 (ops UI or principal always-track)
