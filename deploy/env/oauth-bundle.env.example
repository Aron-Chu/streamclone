# Optional bundled Twitch OAuth app for desktop installs (Sign in button).
# Copy to oauth-bundle.env and fill in, or set GitHub Actions secrets on release:
#   TWITCH_OAUTH_CLIENT_ID, TWITCH_OAUTH_CLIENT_SECRET
#
# Register once at https://dev.twitch.tv/console/apps — no redirect URL required.
# Do not commit oauth-bundle.env (contains client secret).

TWITCH_OAUTH_CLIENT_ID=
TWITCH_OAUTH_CLIENT_SECRET=
