# Optional local Twitch OAuth app for desktop Sign in (never packaged in releases).
#
# Copy this file to oauth-bundle.env in your local checkout and fill values from
# your own Twitch developer application:
#   https://dev.twitch.tv/console/apps
#
# Operators must provide their own credentials through this approved local path
# (or `twitch configure` + setup sync). Distributed clients cannot protect a
# Twitch client secret — releases must never embed one.
#
# Do not commit oauth-bundle.env.

TWITCH_OAUTH_CLIENT_ID=
TWITCH_OAUTH_CLIENT_SECRET=
