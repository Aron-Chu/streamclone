# Local dev / UI hybrid — remote Azure scraper; capture workers run on Azure Mode B plane.
# Merge into local .env when using hybrid rollout (local scraper profile OFF).

SCRAPER_API_URL=http://azure-streamclone:8000/v2/scrape

# Workers OFF on local analytics — Azure owns Tier-0 / Bronze / backfill in Mode B
TIER0_ENABLED=false
BRONZE_ENABLED=false
BACKFILL_ENABLED=false
GOLD_BACKFILL_ENABLED=false

# Local dev Postgres unchanged; manual sync + optional export still work
ARCHIVE_ENABLED=true
ARCHIVE_EXPORT_ON_SYNC=true
