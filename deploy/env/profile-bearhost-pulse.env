# Pulse extension API on BearHost — Cloudflare Tunnel → localhost:8090
# Merge after profile-bearhost-prod.env; do NOT merge profile-bearhost-corpus.env on the same host
# unless corpus workers are intentionally stopped (see scripts/bearhost-pulse-api.sh).

PUBLIC_ORIGIN=https://api.streampulse.stream
APP_DOMAIN=api.streampulse.stream

# Live Pulse plane (IRC collector + rollups in analytics container)
TIER0_ENABLED=true
CORPUS_WORKERS_ENABLED=0

# Corpus/backfill off — do not starve live tracking on an 8 GB VPS
BACKFILL_ENABLED=false
GOLD_BACKFILL_ENABLED=false
BRONZE_ENABLED=false
ARCHIVE_ENABLED=false
SILVER_AUTO_ENQUEUE_ENABLED=false

# Hosted beta (set PULSE_BETA_KEYS in /etc/streamclone/secrets/pulse-beta.env — never commit)
PULSE_HOSTED_MODE=true
PULSE_MAX_ACTIVE_CHANNELS=10
PULSE_MAX_BACKFILLS=1
PULSE_MAX_ALWAYS_TRACKED_PER_PRINCIPAL=10
PULSE_WATCH_RATE_PER_MIN=6
PULSE_BACKFILL_RATE_PER_HOUR=5
MAX_CONCURRENT_TRACKED_CHANNELS=10

# Live emote deltas via 7TV EventAPI (on-demand ensure still runs without it)
SEVENTV_EVENTAPI_ENABLED=true

# Shown in /v1/extension/health version field (keep in sync with VERSION file)
STREAMCLONE_VERSION=v0.3.0-rc4

# Emote CDN URLs served via the same tunnel hostname
EMOTE_SERVICE_URL=http://emote:8080

# Required for live VOD ID lookup (Helix VideoIDByStreamID) — set in BearHost secrets, not committed:
# TWITCH_OAUTH_CLIENT_ID=
# TWITCH_OAUTH_CLIENT_SECRET=
