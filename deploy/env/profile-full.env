# Full profile — core + Analytics scraper (no in-repo clipper)
SCRAPER_USE_IMAGES=1
SCRAPER_API_URL=http://scraper:8000/v2/scrape
SCRAPER_EPHEMERAL_BROWSER=true
SCRAPER_MAX_CONCURRENT=1
SCRAPER_BROWSER_POOL_SIZE=1
SCRAPER_HEADLESS=true
# Pulse Wire social ingest — bounded browser use on shared scraper (see docs/options.md)
REDDIT_COMMERCIAL_OK=true
STORYGRAPH_SOCIAL_BROWSER_FETCH_BUDGET=2
STORYGRAPH_YOUTUBE_BROWSER_FETCH_BUDGET=2
