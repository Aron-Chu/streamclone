# BearHost IP-only HTTP — same routes as deploy/Caddyfile without ACME/TLS.
# Swap to deploy/Caddyfile when APP_DOMAIN has DNS + ACME_EMAIL.

:80 {
	encode zstd gzip

	@chat {
		path /v1/auth* /v1/me /v1/me/followed /v1/logout /v1/ws
	}
	reverse_proxy @chat chat:8080

	@video {
		path /v1/stream /v1/stream/*
	}
	reverse_proxy @video video:8080

	@emote {
		path /v1/channels/*/emotes /v1/channels/*/emotes/* /v1/emotes* /v1/sets* /v1/seed*
	}
	reverse_proxy @emote emote:8080

	@emote_assets {
		path /emotes/*
	}
	reverse_proxy @emote_assets minio:9000

	@analytics {
		path /v1/analytics /v1/analytics/* /v1/extension /v1/extension/* /v1/pulse /v1/pulse/*
	}
	reverse_proxy @analytics analytics:8080 {
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	@admin_archive {
		path /v1/admin/archive /v1/admin/archive/* /v1/admin/system /v1/admin/system/*
	}
	reverse_proxy @admin_archive analytics:8080 {
		transport http {
			read_timeout 15m
			write_timeout 15m
		}
	}

	@storygraph {
		path /v1/pulse-wire /v1/pulse-wire/* /v1/channels/*/spread /v1/channels/*/spread/*
	}
	reverse_proxy @storygraph storygraph:8080

	@hls {
		path /live/*
	}
	reverse_proxy @hls mediamtx:8888 {
		header_up Authorization "Bearer streamclone-local-hls-cdn"
	}

	@setup_control {
		path /v1/setup-control /v1/setup-control/*
	}
	route @setup_control {
		uri strip_prefix /v1/setup-control
		reverse_proxy host.docker.internal:9191 {
			transport http {
				read_timeout 15m
				write_timeout 15m
				response_header_timeout 15m
			}
		}
	}

	@clipper {
		path /v1/clipper /v1/clipper/*
	}
	route @clipper {
		uri replace /v1/clipper /v1
		reverse_proxy host.docker.internal:8095
	}

	@metadata {
		path /v1/*
	}
	reverse_proxy @metadata metadata:8080

	reverse_proxy frontend:80
}
