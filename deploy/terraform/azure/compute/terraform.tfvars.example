# Copy to terraform.tfvars (gitignored) and edit before apply.
# Prerequisites: az login, SSH public key, operator IP for SSH.

resource_group_name = "rg-streamclone-prod"
location            = "eastus"
vm_name             = "azure-streamclone"
vm_size             = "Standard_B2s"
admin_username      = "streamclone"

# Required — paste contents of ~/.ssh/id_ed25519.pub (or your deploy key).
admin_ssh_public_key = "ssh-ed25519 AAAA... you@host"

# Operator /32 or office CIDR — only source allowed to SSH (port 22).
allowed_ssh_cidr = "203.0.113.10/32"

os_disk_size_gb = 128

create_budget_alert = true
budget_amount_usd   = 25
# budget_alert_emails = ["you@example.com"]
