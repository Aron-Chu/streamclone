LOG_LEVEL=info
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

DATABASE_URL=postgres://app:app@postgres:5432/streamclone?sslmode=disable
REDIS_URL=redis://redis:6379/0

TWITCH_GQL_URL=https://gql.twitch.tv/gql
TWITCH_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko
TWITCH_USHER_URL=https://usher.ttvnw.net
TWITCH_IRC_URL=wss://irc-ws.chat.twitch.tv:443

SEVENTV_API_URL=https://7tv.io/v3
SEVENTV_CDN_URL=https://cdn.7tv.app
FFZ_API_URL=https://api.frankerfacez.com/v1

META_CACHE_TTL=30s
STALE_TTL=24h
TWITCHTRACKER_API_URL=https://twitchtracker.com/api
REDDIT_API_URL=https://www.reddit.com
REDDIT_PROVIDER=off
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ACCESS_TOKEN=
REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token
REDDIT_OAUTH_API_URL=https://oauth.reddit.com
REDDIT_HTML_FALLBACK=true
REDDIT_THIRD_PARTY_URL=
REDDIT_THIRD_PARTY_KEY=
# Scraper (only needed with `make up-scraper` / `--profile scraper`):
# Clone sibling repo https://github.com/Aron-Chu/streamclone-scraper next to this repo.
# Use http://localhost:8000/v2/scrape if running Go services bare metal.
SCRAPER_API_URL=http://scraper:8000/v2/scrape
SCRAPER_API_KEY=local-dev-key
# Full scraper browser/proxy settings — see streamclone-scraper README when using --profile scraper.
# YouTube channel metadata (metadata service /v1/channels/{login}/youtube)
YOUTUBE_API_KEY=
YOUTUBE_PROVIDER=auto
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3

STREAM_IDLE_TIMEOUT=60s
MAX_CONCURRENT_STREAMS=20
STREAM_WORKER_BACKENDS=streamlink,direct_hls
DEFAULT_STREAM_QUALITY=best
MEDIAMTX_RTMP=mediamtx:1935
HLS_INTERNAL_BASE=http://mediamtx:8888
HLS_PUBLIC_BASE=http://localhost:8090
BACKEND_VERSION=dev

BATCH_WINDOW_MS=20
CLIENT_SEND_QUEUE=256
MAX_CHANNELS_PER_SOCKET=30
DELTA_DEBOUNCE_MS=300
MAX_CONCURRENT_TRACKED_CHANNELS=50
ANALYTICS_POLL_INTERVAL=15s
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_TOP_EMOTES_PER_MINUTE=200
# Parallel VOD chat workers (max 6). Use 6 for 6h+ VODs in local dev.
ANALYTICS_VOD_GQL_CONCURRENCY=6
ANALYTICS_VOD_GQL_CONCURRENCY_MIN=3
ANALYTICS_VOD_GQL_CONCURRENCY_MAX=8
ANALYTICS_VOD_GQL_SEGMENT_SECONDS=300
ANALYTICS_VOD_GQL_DENSE_SEGMENT_SECONDS=120
ANALYTICS_VOD_GQL_HOT_SEGMENT_PAGE_THRESHOLD=50
# Keep false for faster fetch (tokenize/DB after GQL completes). Set true for live incremental rollups.
ANALYTICS_VOD_GQL_INCREMENTAL_DB=false
# TwitchTracker scrape cache (maxAge ms sent to streamclone-scraper). 0 = tiered policy by stream age.
ANALYTICS_PASS_TT_MAXAGE=true
ANALYTICS_TT_MAX_AGE_MS=0
ANALYTICS_TT_DIRECT_HTTP_ENABLED=false
ANALYTICS_TT_DIRECT_HTTP_TIMEOUT_MS=1200
ALWAYS_TRACKED_CHANNELS=sodapoppin,xqc

TWITCH_OAUTH_CLIENT_ID=
TWITCH_OAUTH_CLIENT_SECRET=
# Optional legacy value; redirect OAuth login was removed. Device-code local auth does not need this.
# TWITCH_OAUTH_REDIRECT_URL=http://localhost:8090/v1/auth/twitch/callback
FRONTEND_ORIGIN=http://localhost:8090
AUTH_COOKIE_SECRET=dev-insecure-cookie-secret
AUTH_COOKIE_SAMESITE=lax
TWITCH_AUTH_SCOPES=chat:read chat:edit user:read:follows
TWITCH_DEV_TOKEN_IMPORT_ENABLED=true
APP_DOMAIN=yourname.duckdns.org
ACME_EMAIL=you@example.com
PUBLIC_ORIGIN=http://localhost:8090
PUBLIC_ORIGIN_WS=ws://localhost:8090

S3_ENDPOINT=http://minio:9000
S3_BUCKET=emotes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_PUBLIC_BASE=http://localhost:8090/emotes
EMOTE_IMPORT_CONCURRENCY=8
EMOTE_WORKER_CONCURRENCY=8
EMOTE_DICTIONARY_DEBOUNCE_MS=3000

CURATOR_API_TOKEN=change-me

MAX_RETAINED_MESSAGES=200

CLIPPER_HOST=127.0.0.1
CLIPPER_PORT=8095
CLIPPER_WEBHOOK_TOKEN=
# Same value as CLIPPER_WEBHOOK_TOKEN — enables Clip Studio save/export when webhook auth is on
VITE_CLIPPER_TOKEN=
CLIPPER_TWITCH_CLIENT_ID=
CLIPPER_TWITCH_USER_ACCESS_TOKEN=
CLIPPER_TWITCH_API_URL=https://api.twitch.tv/helix
CLIPPER_TWITCH_IRC_URL=wss://irc-ws.chat.twitch.tv:443
CLIPPER_DATA_DIR=clipper-data
CLIPPER_OUTPUT_DIR=clipper-data/output
CLIPPER_DB_PATH=clipper-data/clipper.sqlite
CLIPPER_SOURCE_DURATION=60
CLIPPER_FINAL_DURATION=30
CLIPPER_EVENT_LATENCY_OFFSET_SECONDS=8
CLIPPER_DUPLICATE_WINDOW_SECONDS=60
CLIPPER_COOLDOWN_SECONDS=120
CLIPPER_CLIP_POLL_TIMEOUT_SECONDS=60
CLIPPER_CLIP_POLL_INTERVAL_SECONDS=1.5
# false (default): download source + optional ASR, then open Clip Studio; export renders final MP4 on demand.
# true: legacy path — auto-render final MP4 before marking job ready.
CLIPPER_AUTO_RENDER=false
CLIPPER_CHAT_WINDOW_SECONDS=12
CLIPPER_CHAT_MIN_MESSAGES=18
CLIPPER_CHAT_SPIKE_MULTIPLIER=2.5
CLIPPER_ASR_ENABLED=true
CLIPPER_ASR_REQUIRED=false
CLIPPER_WHISPER_MODEL=small
CLIPPER_WHISPER_COMPUTE_TYPE=int8
CLIPPER_STREAMLINK_BIN=streamlink
CLIPPER_FFMPEG_ENCODER=libx264
CLIPPER_FFMPEG_PRESET=veryfast
CLIPPER_FFMPEG_BIN=ffmpeg
CLIPPER_FINAL_RETENTION_HOURS=48
CLIPPER_CLEANUP_INTERVAL_SECONDS=3600
