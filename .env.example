# You do not need this file for local setup.
# Run `make setup` or see docs/install-desktop.md.
# .env is synthesized from .env.example + deploy/env/profile-dev.env + deploy/env/profile-*.env + generated secrets.
# Release installs also merge deploy/env/release-bundle.env (auto-generated in the desktop bundle):
#   IMAGE_TAG, STREAMCLONE_USE_IMAGES, PULSE_WIRE_ENABLED, REDDIT_COMMERCIAL_OK, TWITCH_DEV_TOKEN_IMPORT_ENABLED=false, etc.

LOG_LEVEL=info
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

DATABASE_URL=postgres://app:app@postgres:5432/streamclone?sslmode=disable
REDIS_URL=redis://redis:6379/0

TWITCH_GQL_URL=https://gql.twitch.tv/gql
TWITCH_CLIENT_ID=kimne78kx3ncx6brgo4mv6wki5h1ko
TWITCH_USHER_URL=https://usher.ttvnw.net
TWITCH_IRC_URL=wss://irc-ws.chat.twitch.tv:443

SEVENTV_API_URL=https://7tv.io/v3
SEVENTV_CDN_URL=https://cdn.7tv.app
FFZ_API_URL=https://api.frankerfacez.com/v1

META_CACHE_TTL=30s
STALE_TTL=24h
TWITCHTRACKER_API_URL=https://twitchtracker.com/api
REDDIT_API_URL=https://www.reddit.com
# Pulse tab LSF threads: metadata fetches r/LivestreamFail via public Reddit JSON by default (no scraper required).
# Set auto/scraper to force provider paths; set oauth for Reddit API thumbnails (requires client id/secret + token).
# Set off to use the built-in JSON -> scraper -> HTML chain.
REDDIT_PROVIDER=off
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_ACCESS_TOKEN=
REDDIT_TOKEN_URL=https://www.reddit.com/api/v1/access_token
REDDIT_OAUTH_API_URL=https://oauth.reddit.com
REDDIT_HTML_FALLBACK=true
REDDIT_THIRD_PARTY_URL=
REDDIT_THIRD_PARTY_KEY=
# Scraper (only needed with `make up-scraper` / `--profile scraper`):
# Clone sibling repo https://github.com/Aron-Chu/streamclone-scraper next to this repo.
# Use http://localhost:8000/v2/scrape if running Go services bare metal.
SCRAPER_API_URL=http://scraper:8000/v2/scrape
SCRAPER_API_KEY=local-dev-key
# Full scraper browser/proxy settings — see streamclone-scraper README when using --profile scraper.
# YouTube channel metadata (metadata service /v1/channels/{login}/youtube)
YOUTUBE_API_KEY=
YOUTUBE_PROVIDER=auto
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
# Pulse Wire global YouTube search keywords (comma-separated streamer or story terms)
STORYGRAPH_YT_KEYWORDS=kai cenat,xqc,caseoh,streamer drama

STREAM_IDLE_TIMEOUT=3m
MAX_CONCURRENT_STREAMS=20
STREAM_WORKER_BACKENDS=direct_hls,streamlink
DEFAULT_STREAM_QUALITY=best
MEDIAMTX_RTMP=mediamtx:1935
HLS_INTERNAL_BASE=http://mediamtx:8888
HLS_PUBLIC_BASE=http://localhost:8090
BACKEND_VERSION=dev
# LL-HLS is off by default — republished Twitch via ffmpeg copy→RTMP may misalign EXT-X-PART.
HLS_LOW_LATENCY_ENABLED=false
MTX_HLSVARIANT=mpegts
MTX_HLSSEGMENTCOUNT=10
MTX_HLSSEGMENTDURATION=2s
# MediaMTX env overrides use the fully-uppercase parameter name (MTX_HLSPARTDURATION).
MTX_HLSPARTDURATION=200ms
# Optional tighter window (Mode A): MTX_HLSSEGMENTCOUNT=8 MTX_HLSSEGMENTDURATION=1s
# A2 adaptive live-latency controller (jump-to-live + gentle catch-up). Off => today's one-way downgrade.
ADAPTIVE_LIVE_LATENCY_ENABLED=false

# Enable on dev/hosted stacks for fresher channel emote sets (emote service subscribes on ensure).
SEVENTV_EVENTAPI_ENABLED=false
SEVENTV_EVENTAPI_URL=wss://events.7tv.io/v3

BATCH_WINDOW_MS=20
# Optional live chat archive (local Postgres via analytics ingest)
CHAT_LOG_PERSIST_ENABLED=false
CHAT_LOG_RETENTION_DAYS=14
ANALYTICS_SERVICE_URL=http://analytics:8080
# Keep URLs in synced VOD chat rows (local fidelity)
ANALYTICS_VOD_CHAT_PRESERVE_URLS=0
# Persist per-message VOD chat for sidebar replay (requires re-sync to backfill existing streams)
ANALYTICS_VOD_CHAT_REPLAY_ENABLED=1
ANALYTICS_VOD_CHAT_SENDER_SALT=local-dev
CLIENT_SEND_QUEUE=256
MAX_CHANNELS_PER_SOCKET=30
DELTA_DEBOUNCE_MS=300
MAX_CONCURRENT_TRACKED_CHANNELS=50
ANALYTICS_POLL_INTERVAL=15s
ANALYTICS_RETENTION_DAYS=30
ANALYTICS_TOP_EMOTES_PER_MINUTE=200
# Parallel VOD chat workers (hard cap 8 in sync worker). Trial: CONCURRENCY=8, MIN=3, MAX=8.
ANALYTICS_VOD_GQL_CONCURRENCY=8
ANALYTICS_VOD_GQL_CONCURRENCY_MIN=3
ANALYTICS_VOD_GQL_CONCURRENCY_MAX=8
ANALYTICS_VOD_GQL_SEGMENT_SECONDS=300
ANALYTICS_VOD_GQL_DENSE_SEGMENT_SECONDS=120
# Split dense segments after N pages, slow offset advance, or high comments/page (see analytics steering).
ANALYTICS_VOD_GQL_HOT_SEGMENT_PAGE_THRESHOLD=10
ANALYTICS_VOD_GQL_HOT_SLOW_ADVANCE_SEC=30
ANALYTICS_VOD_GQL_HOT_SLOW_ADVANCE_PAGES=5
ANALYTICS_VOD_GQL_HOT_COMMENTS_PER_PAGE=80
ANALYTICS_VOD_GQL_PRIORITY_EDGE_SECONDS=600
# Live chart fill during sync (writes chat rollups per GQL segment). Set false to batch at end only.
ANALYTICS_VOD_GQL_INCREMENTAL_DB=true
# Defer expensive analytics_streams summary refresh until the end of a parallel GQL job.
ANALYTICS_VOD_GQL_DEFER=true
# Coalesce incremental rollup patches across multiple completed GQL segments.
ANALYTICS_VOD_GQL_ROLLUP_FLUSH_SEGMENTS=8
ANALYTICS_VOD_GQL_ROLLUP_FLUSH_MS=2000
# TwitchTracker scrape cache (maxAge ms sent to streamclone-scraper). 0 = tiered policy by stream age.
ANALYTICS_PASS_TT_MAXAGE=true
ANALYTICS_TT_MAX_AGE_MS=0
# Archived streams (>48h): scraper cache TTL floor (default 7d). 0 = use built-in tier (24h–7d).
ANALYTICS_TT_STALE_MAX_AGE_MS=604800000
# Warm TwitchTracker HTML in scraper cache on stream-list hover (POST prefetch-tracker).
ANALYTICS_TT_PREFETCH_ENABLED=true
ANALYTICS_TT_DIRECT_HTTP_ENABLED=false
# When true, skip direct HTTP for streams ended <6h ago (avoids wasted CF challenge attempts).
ANALYTICS_TT_DIRECT_HTTP_STALE_ONLY=false
ANALYTICS_TT_DIRECT_HTTP_TIMEOUT_MS=1200
# First TwitchTracker attempt during sync (ms). Background retry uses ANALYTICS_TRACKER_SCRAPE_TIMEOUT_MS.
ANALYTICS_TT_SYNC_TIMEOUT_MS=45000
ANALYTICS_TT_BACKGROUND_RETRY_ENABLED=true
# Skip fresh browser scrapes briefly after CF/timeouts (Redis-backed; reduces Camoufox hammering).
ANALYTICS_TT_SCRAPE_BACKOFF_ENABLED=true

# Pulse extension hosted API (BearHost + Cloudflare Tunnel — see docs/pulse-extension/bearhost-tunnel.md)
# PULSE_HOSTED_MODE=true
# PULSE_BETA_KEYS=set-on-vps-only-never-commit
# PULSE_MAX_ACTIVE_CHANNELS=10
# Top-roster IRC admission (hosted only after Pulse Live P0 soak — see docs/agent-notes/pulse-live-p0-hosted-admission-2026-07.md)
# Canonical: PULSE_LIVE_ADMISSION_* ; legacy PULSE_TOP500_* still read via config aliases
# PULSE_LIVE_ADMISSION_ENABLED=false
# PULSE_LIVE_ADMISSION_TOP_N=100
# PULSE_LIVE_ADMISSION_SOURCE=helix_top_live
# PULSE_LIVE_ADMISSION_SOURCE=roster
# PULSE_LIVE_ADMISSION_SOURCE=roster_then_helix
# PULSE_LIVE_ADMISSION_INTERVAL=30s
# PULSE_TOP500_ADMISSION_ENABLED=false
# PULSE_TOP500_ADMISSION_TOP_N=100
# PULSE_TOP500_ADMISSION_SOURCE=helix_top_live
# PULSE_TOP500_ADMISSION_INTERVAL=30s
# PULSE_MAX_BACKFILLS=1
# Ingest-core (bounded live path — see docs/pulse-ingest-v2/ingest-core-runbook.md)
# INGEST_CORE_ENABLED=0
# INGEST_CORE_DUAL_READ_MODE=0
# INGEST_CORE_SHADOW_MODE=0
# INGEST_TIERING_ENABLED=0
# HUB_ROSTER_LIMIT=250
# INGEST_P1_HOT_LIMIT=50
# INGEST_CANDIDATE_SCAN_TOP_N=500
# PUBLIC_HUB_LIVE_CAP=250
# INGEST_SHARD_COUNT=32
# INGEST_IRC_QUEUE_SIZE=8192
# INGEST_P0_QUEUE_RESERVE=2048
# INGEST_FLUSH_INTERVAL=3s
# INGEST_FLUSH_MAX_BATCH=500
# INGEST_OPEN_MINUTE_FLUSH_INTERVAL=5s
# SCRAPER_ENABLED_ON_API_NODE=0
# BACKFILL_MAX_PARALLEL_STREAMS=1
# REDIS_POOL_SIZE=32
# PULSE_MAX_CHANNELS_PER_PRINCIPAL=10
# PULSE_WATCH_RATE_PER_MIN=6
# PULSE_BACKFILL_RATE_PER_HOUR=5
# Backend-generated private clip candidate controls. Defaults preserve recap output.
PULSE_CLIP_MAX_CANDIDATES=0
PULSE_CLIP_MIN_SCORE=0
PULSE_CLIP_MIN_CONFIDENCE=0
PULSE_CLIP_MIN_CHAT_COUNT=0
PULSE_CLIP_MAX_CHAT_COUNT=0
PULSE_CLIP_MIN_EMOTE_COUNT=0
PULSE_CLIP_MIN_PROVIDER_EMOTE_COUNT=0
PULSE_CLIP_PROVIDER_EMOTE_PROVIDER=seventv
PULSE_CLIP_MIN_NON_MISSING_ROLLUP_MINUTES=0
PULSE_CLIP_DUPLICATE_RADIUS_SECONDS=0
PULSE_CLIP_MAX_CANDIDATES_PER_HOUR=0
PULSE_CLIP_REQUIRE_SOURCE_AVAILABLE=false
# PUBLIC_ORIGIN=https://api.streampulse.stream
# APP_DOMAIN=api.streampulse.stream
# STREAMCLONE_VERSION=v0.5.0
# SEVENTV_EVENTAPI_ENABLED=true
# TIER0_ENABLED=true
# CORPUS_WORKERS_ENABLED=0
# Median smooth window for TT-derived viewer points before minute rollup (0=off, 3=recommended for ecs charts)
ANALYTICS_TT_VIEWER_SMOOTH_WINDOW=0
# Quiet long VODs use larger GQL segments (default 15 min) instead of 5 min hot-split chunks.
ANALYTICS_VOD_GQL_QUIET_SEGMENT_SECONDS=900
# Scraper pool (deploy/docker-compose.yml defaults: ephemeral=false, pool=1, concurrent=2):
# SCRAPER_EPHEMERAL_BROWSER=false
# SCRAPER_BROWSER_POOL_SIZE=1
# REDDIT_LSF_LOW_PRIORITY=true
# When true (default), Pulse LSF uses one short scraper search and does not auto-start on tab open.
# SCRAPER_CONTEXT_TTL_REQUESTS=50
# SCRAPER_BROWSER_TTL_SECONDS=3600
# SCRAPER_TT_DETAIL_CACHE_MS=604800000
ALWAYS_TRACKED_CHANNELS=sodapoppin,xqc

TWITCH_OAUTH_CLIENT_ID=
TWITCH_OAUTH_CLIENT_SECRET=
# Optional legacy value; redirect OAuth login was removed. Device-code local auth does not need this.
# TWITCH_OAUTH_REDIRECT_URL=http://localhost:8090/v1/auth/twitch/callback
FRONTEND_ORIGIN=http://localhost:8090
AUTH_COOKIE_SECRET=dev-insecure-cookie-secret
AUTH_COOKIE_SAMESITE=lax
TWITCH_AUTH_SCOPES=chat:read chat:edit user:read:follows
TWITCH_DEV_TOKEN_IMPORT_ENABLED=true
APP_DOMAIN=yourname.duckdns.org
ACME_EMAIL=you@example.com
PUBLIC_ORIGIN=http://localhost:8090
PUBLIC_ORIGIN_WS=ws://localhost:8090

S3_ENDPOINT=http://minio:9000
S3_BUCKET=emotes
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_PUBLIC_BASE=http://localhost:8090/emotes
EMOTE_IMPORT_CONCURRENCY=8
EMOTE_WORKER_CONCURRENCY=8
EMOTE_DICTIONARY_DEBOUNCE_MS=3000
# Demand-driven emote rendering (metadata eager, local WebP lazy)
EMOTE_RENDER_TWITCH_EAGER=false
EMOTE_RENDER_THIRDPARTY_EAGER=false
EMOTE_RENDER_ON_CHAT_OBSERVED=true
EMOTE_RENDER_ON_UI_REQUEST=true
EMOTE_RENDER_DEFAULT_SCALES=1x
EMOTE_RENDER_ALLOWED_SCALES=1x,2x,3x,4x
EMOTE_RENDER_QUEUE_MAX_DEPTH=5000
EMOTE_RENDER_CHAT_OBSERVED_RATE_LIMIT_PER_MIN=120
EMOTE_RENDER_UI_REQUEST_RATE_LIMIT_PER_MIN=300
EMOTE_RENDER_BACKFILL_ENABLED=false
# Preload 7TV/FFZ for directory top-N + ALWAYS_TRACKED_CHANNELS (local emote service)
# EMOTE_ROSTER_PRELOAD_ENABLED=false
# EMOTE_ROSTER_PRELOAD_TOP_N=200
# EMOTE_ROSTER_PRELOAD_INTERVAL=30m

CURATOR_API_TOKEN=change-me

MAX_RETAINED_MESSAGES=200

CLIPPER_HOST=127.0.0.1
CLIPPER_PORT=8095
CLIPPER_WEBHOOK_TOKEN=
# Server-only Streamclone callback secret for ReplayForge -> Streamclone job status webhooks.
# Do not reuse VITE_CLIPPER_TOKEN or expose this to frontend runtime config.
REPLAYFORGE_CALLBACK_TOKEN=
# ReplayForge API (default :8095). Streamclone frontend calls this for clip jobs; run ReplayForge separately.
VITE_CLIPPER_URL=http://localhost:8095
# ReplayForge UI (default :8096). /studio routes redirect here when set.
VITE_REPLAYFORGE_UI_URL=http://localhost:8096
# Browser-visible Clip Studio bearer. Leave empty unless this is a trusted local install
# where browser-originated ReplayForge mutations are allowed.
VITE_CLIPPER_TOKEN=
CLIPPER_TWITCH_CLIENT_ID=
CLIPPER_TWITCH_USER_ACCESS_TOKEN=
# Written by make twitch-local-auth; synced to ReplayForge token env via refresh-auth
CLIPPER_TWITCH_REFRESH_TOKEN=
CLIPPER_TWITCH_API_URL=https://api.twitch.tv/helix
CLIPPER_TWITCH_IRC_URL=wss://irc-ws.chat.twitch.tv:443
CLIPPER_DATA_DIR=clipper-data
CLIPPER_OUTPUT_DIR=clipper-data/output
CLIPPER_DB_PATH=clipper-data/clipper.sqlite
CLIPPER_SOURCE_DURATION=60
CLIPPER_FINAL_DURATION=30
CLIPPER_EVENT_LATENCY_OFFSET_SECONDS=8
CLIPPER_DUPLICATE_WINDOW_SECONDS=60
CLIPPER_COOLDOWN_SECONDS=120
CLIPPER_CLIP_POLL_TIMEOUT_SECONDS=60
CLIPPER_CLIP_POLL_INTERVAL_SECONDS=1.5
# false (default): download source + optional ASR, then open Clip Studio; export renders final MP4 on demand.
# true: legacy path — auto-render final MP4 before marking job ready.
CLIPPER_AUTO_RENDER=false
CLIPPER_CHAT_WINDOW_SECONDS=12
CLIPPER_CHAT_MIN_MESSAGES=18
CLIPPER_CHAT_SPIKE_MULTIPLIER=2.5
CLIPPER_ASR_ENABLED=true
CLIPPER_ASR_REQUIRED=false
CLIPPER_WHISPER_MODEL=small
CLIPPER_WHISPER_COMPUTE_TYPE=int8
CLIPPER_STREAMLINK_BIN=streamlink
CLIPPER_FFMPEG_ENCODER=libx264
CLIPPER_FFMPEG_PRESET=veryfast
CLIPPER_FFMPEG_BIN=ffmpeg
CLIPPER_FINAL_RETENTION_HOURS=48
CLIPPER_CLEANUP_INTERVAL_SECONDS=3600

# Pulse dashboards (Grafana/InfluxDB) are optional. Normal Analytics stays Postgres-backed when this is false.
# Not the same as Pulse Wire (/pulse-wire story graph) — see PULSE_WIRE_* below.
TIMESERIES_ENABLED=false
TIMESERIES_BACKEND=influxdb
INFLUXDB_URL=
INFLUXDB_TOKEN=local-pulse-token
INFLUXDB_ORG=streamclone
INFLUXDB_BUCKET=streamclone
TIMESERIES_WRITE_TIMEOUT_MS=1000
TIMESERIES_QUEUE_SIZE=1024
INFLUXDB_INIT_USERNAME=admin
INFLUXDB_INIT_PASSWORD=streampulse
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=streampulse

# Pulse Wire (story graph social spread + /pulse-wire page). storygraph always runs; this gates UI + ingest.
# Desktop releases set PULSE_WIRE_ENABLED=true via release-bundle.env; dev default is false.
STORYGRAPH_INGEST_INTERVAL=5m
# Bounded scraper use for Pulse Wire social corroboration (0 = off; protects Analytics TT preflight)
# STORYGRAPH_SOCIAL_BROWSER_FETCH_BUDGET=2
# STORYGRAPH_YOUTUBE_BROWSER_FETCH_BUDGET=1
# STORYGRAPH_SOCIAL_SCRAPE_USE_PROXY=false
PULSE_DIRECTORY_SAMPLE_INTERVAL=10m
PULSE_DIRECTORY_TOP_N=200
PULSE_DIRECTORY_RETENTION_DAYS=30
PULSE_WIRE_ENABLED=false
PULSE_WIRE_SEMANTIC=false
REDDIT_COMMERCIAL_OK=false
SOCIAL_RETENTION_DAYS=90
# Pulse Wire StreamerBans tier-1 ingest (HTML parse; optional x-ingest for tier 2).
STREAMERBANS_INGEST_ENABLED=false
# Tier 2 (optional, credential-gated): exact @StreamerBans tweet URLs via x-ingest/emusks sidecar.
# Requires PULSE_WIRE_ENABLED=true and docker compose --profile pulse-wire up x-ingest
X_UNOFFICIAL_OK=false
X_AUTH_TOKEN=
EMUSKS_X_AUTH_TOKEN=
# X ingest (emusks) — see https://emusks.tiago.zip/getting-started/ ; service: cmd/x-ingest on :8098 (pulse-wire profile)
X_INGEST_URL=http://x-ingest:8098
# Dev-only: go test ./internal/storygraph/store/... (drops/recreates public schema — use a dedicated DB, not streamclone).
# STORYGRAPH_STORE_TEST_DATABASE_URL=postgres://app:app@127.0.0.1:5432/streamclone_storygraph_test?sslmode=disable
# YOUTUBE_API_KEY or SCRAPER_API_URL (+ SCRAPER_API_KEY) with STORYGRAPH_YT_KEYWORDS enable global YouTube evidence in Pulse Wire.
# Optional sidecar when PULSE_WIRE_ENABLED=true (compose profile pulse-wire):
# MEDIA_MATCHER_URL=http://media-matcher:8001

# --- Cold archive (Azure Blob) — see docs/azure-archive-setup.md + docs/scraping-archive/requirements.md ---
# Provision storage: deploy/terraform/azure/archive/ (Terraform). Credentials in .env.local only.
# Archive/backfill profile overlay: deploy/env/profile-archive.env
# ARCHIVE_ENABLED=false
# ARCHIVE_STORAGE_PROVIDER=azure
# ARCHIVE_AZURE_STORAGE_ACCOUNT=your-storage-account
# ARCHIVE_AZURE_CONTAINER=streamclone-archive
# ARCHIVE_AZURE_PREFIX=streamclone
# ARCHIVE_AZURE_CONNECTION_STRING_FILE=/path/to/azure-archive-connection-string
# Optional R2 staging (STOR-R2-003 — disabled by default; production stays Azure-only):
# ARCHIVE_PRIMARY_PROVIDER=azure
# ARCHIVE_READ_THROUGH=false
# ARCHIVE_DUAL_WRITE=false
# ARCHIVE_R2_BUCKET=streampulse-artifacts-staging
# ARCHIVE_R2_ACCOUNT_ID=51dd8007b22ac92482388d8b6cdbb6e3
# ARCHIVE_R2_PREFIX=archive
# ARCHIVE_R2_ENDPOINT=https://51dd8007b22ac92482388d8b6cdbb6e3.r2.cloudflarestorage.com
# ARCHIVE_R2_ACCESS_KEY_ID_FILE=/path/to/r2-access-key-id
# ARCHIVE_R2_SECRET_ACCESS_KEY_FILE=/path/to/r2-secret-access-key
# ARCHIVE_R2_LIVE_TEST=0
# ARCHIVE_PROTECT_RETENTION=false
# ARCHIVE_EXPORT_INTERVAL=1h
# ARCHIVE_EXPORT_ON_SYNC=false
# ARCHIVE_PG_DUMP_NIGHTLY=true
# TIER0_ENABLED=false
# TIER0_SAMPLE_INTERVAL=45s
# TIER0_ROSTER_INTERVAL=5m
# TIER0_ROSTER_TOP_N=200
# BRONZE_ENABLED=false
# BRONZE_TOP_N=500
# BRONZE_WORKER_INTERVAL=5m
# BRONZE_HELIX_CONCURRENCY=2
# BRONZE_TT_SUMMARY_CONCURRENCY=4
# BACKFILL_ENABLED=false
# BACKFILL_WORKER_INTERVAL=30s
# IVR Gold Lite accelerator (provisional rollups ahead of canonical GQL; all off by default)
# GOLD_IVR_ENABLED=false
# GOLD_IVR_LITE_ENABLED=false
# GOLD_IVR_SHADOW_MODE=false
# GOLD_IVR_SHADOW_ARTIFACT_DIR=runtime/ivr-shadow
# GOLD_IVR_SHADOW_ARTIFACT_RETENTION_DAYS=7
# GOLD_IVR_SHADOW_ARTIFACT_MAX_FILES=1000
# GOLD_ARCHIVE_REQUIRED=true
# Set GOLD_ARCHIVE_REQUIRED=false (or use `backfill gold run-once --no-archive`) for local shadow/GQL proofs without Azure.
# GOLD_IVR_PEAKS_ONLY_ENABLED=false
# GOLD_IVR_PEAKS_ONLY_MAX_MINUTES=5
# GOLD_IVR_PEAKS_ONLY_MIN_CHAT_COUNT=10
# GOLD_IVR_CANONICAL_REPLACE=false
# GOLD_IVR_BASE_URL=https://logs.ivr.fi
# GOLD_IVR_ENABLED_CHANNEL_ALLOWLIST=ludwig
# PROD_SHADOW_CANARY_ONLY: GOLD_IVR_ENABLED=true requires GOLD_IVR_SHADOW_MODE=true and lite/peaks/canonical_replace=false.
# BearHost overlay: deploy/env/profile-bearhost-corpus-ivr-shadow.env (corpus workers only, not Pulse API mode).
# Allowlist: comma-separated Twitch logins (lowercase) and/or numeric broadcaster IDs. Empty = deny all when enabled.
# POST_END_WAIT_MIN=10m
# POST_END_WAIT_MAX=30m
# POST_END_COVERAGE_PCT=70
# Flame residential proxy profiles for benchmark — see deploy/env/proxy-flame.env.example
# PROXY_API_KEY=fp_live_...
# PROXY_API_BASE_URL=https://rapi.flashproxy.com/api/v1
# PROXY_FLAME_PLAN_PREMIUM_ID=
# PROXY_FLAME_PLAN_BUDGET_ID=
# PROXY_FLAME_PREMIUM_SERVER=
# PROXY_FLAME_PREMIUM_USERNAME=
# PROXY_FLAME_PREMIUM_PASSWORD=
# PROXY_FLAME_BUDGET_SERVER=
# PROXY_FLAME_BUDGET_USERNAME=
# PROXY_FLAME_BUDGET_PASSWORD=
